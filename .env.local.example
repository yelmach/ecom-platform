# Manual local services. Copy to .env.local

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=6210
MONGO_USERNAME=admin
MONGO_PASSWORD=password
MONGO_USER_DATABASE=user_db
MONGO_PRODUCT_DATABASE=product_db
MONGO_MEDIA_DATABASE=media_db

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:6232
KAFKA_CLUSTER_ID=wwTYI58hSP6SjTVHPcwdIw
KAFKA_PORT=6230
KAFKA_CONTROLLER_PORT=6231
KAFKA_HOST_PORT=6232

# MinIO
MINIO_ENDPOINT=http://localhost:6220
MINIO_API_PORT=6220
MINIO_CONSOLE_PORT=6221
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_BUCKET=ecom-media
MEDIA_PUBLIC_BASE_URL=http://localhost:6100/ecom-media

CORS_ALLOWED_ORIGINS=http://localhost:6100

# Eureka
EUREKA_HOST=localhost
EUREKA_PORT=6204

# Service ports
FRONTEND_PORT=6100
GATEWAY_PORT=6200
USER_SERVICE_PORT=6201
PRODUCT_SERVICE_PORT=6202
MEDIA_SERVICE_PORT=6203

# JWT
JWT_PRIVATE_KEY_PATH=../keys/private.pem
JWT_PUBLIC_KEY_PATH=../keys/public.pem
JWT_EXPIRATION=24h

JENKINS_PORT=6300
SONARQUBE_PORT=6310
