# run app in Docker, Copy to .env

# prod env
GHCR_PREFIX=ghcr.io/yelmach
IMAGE_TAG=
APP_DOMAIN=ecom.yelmach.com

# MongoDB
MONGO_HOST=mongo
MONGO_PORT=6210
MONGO_USERNAME=admin
MONGO_PASSWORD=password
MONGO_USER_DATABASE=user_db
MONGO_PRODUCT_DATABASE=product_db
MONGO_MEDIA_DATABASE=media_db

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:6230
KAFKA_CLUSTER_ID=wwTYI58hSP6SjTVHPcwdIw
KAFKA_PORT=6230
KAFKA_CONTROLLER_PORT=6231
KAFKA_HOST_PORT=6232

# MinIO
MINIO_ENDPOINT=http://minio:6220
MINIO_API_PORT=6220
MINIO_CONSOLE_PORT=6221
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_BUCKET=ecom-media
MEDIA_PUBLIC_BASE_URL=http://localhost:6100/ecom-media

CORS_ALLOWED_ORIGINS=http://localhost:6100

# Eureka
EUREKA_HOST=discovery-service
EUREKA_PORT=6204

# Service ports
GATEWAY_PORT=6200
USER_SERVICE_PORT=6201
PRODUCT_SERVICE_PORT=6202
MEDIA_SERVICE_PORT=6203
FRONTEND_PORT=6100

# JWT
JWT_PRIVATE_KEY_PATH=/opt/keys/private.pem
JWT_PUBLIC_KEY_PATH=/opt/keys/public.pem
JWT_EXPIRATION=24h

# Jenkins
JENKINS_PORT=6300
JENKINS_PUBLIC_URL=https://jenkins.yelmach.com/
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
JENKINS_REPOSITORY_URL=https://github.com/yelmach/ecom-platform.git
JENKINS_REPOSITORY_BRANCH=deployment
JENKINS_AGENT_SECRET=

# SonarQube
SONARQUBE_PORT=6310
SONAR_DB_NAME=sonar_db
SONAR_DB_USER=sonarqube
SONAR_DB_PASSWORD=
