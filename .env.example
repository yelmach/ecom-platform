# Docker environment template

# MongoDB
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=password
MONGO_USER_DATABASE=user_db
MONGO_PRODUCT_DATABASE=product_db
MONGO_MEDIA_DATABASE=media_db

# Eureka
EUREKA_HOST=discovery-service
EUREKA_PORT=8761

# Service Ports
GATEWAY_PORT=8443
USER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
MEDIA_SERVICE_PORT=8083
MEDIA_SERVICE_BASE_URL=http://media-service:8083
CORS_ALLOWED_ORIGINS=https://localhost:4200,http://localhost:4200

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_BUCKET=ecom-media
MEDIA_PUBLIC_BASE_URL=https://localhost:8443/ecom-media

# Gateway HTTPS
GATEWAY_SSL_ENABLED=true
GATEWAY_SSL_KEY_STORE=/opt/certs/gateway.p12
GATEWAY_SSL_KEY_STORE_PASSWORD=password
GATEWAY_SSL_KEY_STORE_TYPE=PKCS12

# JWT
JWT_PRIVATE_KEY_PATH=/opt/keys/private.pem
JWT_PUBLIC_KEY_PATH=/opt/keys/public.pem
JWT_EXPIRATION=24h

# SonarQube
SONARQUBE_DB_NAME=sonarqube
SONARQUBE_DB_USER=sonar
SONARQUBE_DB_PASSWORD=password
